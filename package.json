{
  "name": "irm",
  "version": "2.0.0",
  "description": "Industry Relationship Management monorepo",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:apps": "nx run-many -t serve -p web,api --parallel=2",
    "dev:web": "nx serve web",
    "dev:api": "nx serve api",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint-fix",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "affected:check": "nx affected -t lint && nx affected -t typecheck && nx affected -t test && nx affected -t build",
    "graph": "nx graph",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "axios": "1.20.0",
    "element-plus": "2.14.5",
    "jwt-decode": "4.0.0",
    "pinia": "2.3.1",
    "vue": "3.5.42",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.9.1",
    "eslint-plugin-vue": "10.10.0",
    "globals": "16.5.0",
    "jsdom": "30.0.1",
    "nx": "23.1.2",
    "sass-embedded": "1.103.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
