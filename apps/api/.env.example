# Copy these values into the environment used to run the API. Do not commit real secrets.
DB_URL=jdbc:mysql://localhost:3306/internship_application?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=irm
DB_PASSWORD=replace-me
JWT_SECRET=replace-with-at-least-32-random-bytes
RESET_REFERENCE_TTL=30m

# SMTP is optional for read-only startup. OTP-dependent requests return 503 while it is disabled.
# OTP values are never written to logs or stored in plaintext.
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=no-reply@example.com
SMTP_STARTTLS=true
MAIL_LOCALE=en-NZ

CORS_ALLOWED_ORIGINS=http://localhost:4200
SERVER_PORT=7001
