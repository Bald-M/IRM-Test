# Local Docker Compose defaults. Replace every password/secret before use outside local development.
MYSQL_DATABASE=internship_application
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
MYSQL_PORT=3306

# Used by `nx serve api`. Compose rewrites only the hostname from localhost to mysql.
DB_URL=jdbc:mysql://localhost:3306/internship_application?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=irm
DB_PASSWORD=replace-with-a-local-password

# Generate at least 32 random bytes, for example: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes
RESET_REFERENCE_TTL=30m

# Local development sends OTP mail to Mailpit (UI: http://localhost:8025).
MAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@irm.local
SMTP_STARTTLS=false
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Comma-separated browser origins accepted by the API when it is called directly.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
API_PORT=7001
WEB_PORT=8080
